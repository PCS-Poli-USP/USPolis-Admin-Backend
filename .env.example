# Main .env
ENVIRONMENT= # "development" | "production" | "staging"

# LOGGING
LOG_MAX_SIZE= # Maximum size of log files in bytes (default: 1GB)
LOG_BACKUP_COUNT= # Number of backup log files to keep (default: 2)

# CORS
ALLOWED_ORIGINS= # Comma-separated list of allowed origins

# Root
PORT=
FRONTEND_URL= # e.g. https://uspolis.com.br; one-time API key links point here (default: http://localhost:3000)
DEBUG= # "True" or "False"

# Alembic Migration
ALEMBIC_URL=

# SQLAlchemy
DATABASE_URI=
DATABASE_NAME=

# Initial Data
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_NAME=

# Email
MAIL_HOST=
MAIL_ADDRESS=
MAIL_PASSWORD=
MAIL_PORT=

#Google Auth (for mobile app)
G_AUTH_CLIENT_ID=
G_AUTH_DOMAIN_NAME=

#Google Auth (for frontend)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=

# Google Auth allowed gmails
ALLOWED_GMAILS_DOMAINS=
ALLOWED_GMAILS=

# Monitoring and Analytics Services
HEALTH_API_KEY=

# Rate limiting (see docs/RATE_LIMIT.md)
REDIS_URL= # e.g. redis://:<password>@127.0.0.1:6379/0 (empty = rate limiting disabled)
RATE_LIMIT_MODE= # "off" (default) | "shadow" (count + log, never block) | "enforce"
ANON_RATE_LIMITS= # per-IP "max/window_seconds" rules (default: 40/10,150/60,5000/86400)

# Partner API keys (see docs/API_KEYS.md)
API_KEY_SECRET= # 32+ random bytes, different per environment: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_DEFAULT_LIMITS= # server keys without their own limits (default: 30/10,120/60,10000/86400)
API_KEY_BROWSER_DEFAULT_LIMITS= # browser keys without their own limits (default: 60/10,300/60,20000/86400)

#Test / Mock
TEST_DATABASE_URI=
TEST_DATABASE_NAME=
TEST_ALEMBIC_URL=
TESTING=
OVERRIDE_AUTH=
MOCK_EMAIL=

# JupiterWeb schedule import: each crawl runs a headless Chromium (200-500 MB)
JUPITER_CRAWL_MAX_CONCURRENT= # crawls at once on this host (default: 2)
JUPITER_CRAWL_QUEUE_SECONDS= # wait for a free slot before answering 503 (default: 15)
JUPITER_CRAWL_TIMEOUT_SECONDS= # hard cap per crawl, answers 504 (default: 60)
JUPITER_CRAWL_LOCK_DIR= # shared by all workers of the host (default: <tmp>/uspolis-jupiter-crawl)
